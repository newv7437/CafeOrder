# =============================================
# CafeOrder 환경변수 예시 파일
# 이 파일을 복사하여 .env.local로 저장하고 실제 값을 입력하세요.
# .env.local 파일은 절대 git에 커밋하지 마세요!
# =============================================

# ---------------------------
# Supabase 공개 설정 (클라이언트에서 사용 가능)
# ---------------------------
VITE_SUPABASE_URL=https://ubgwqpafpavrxdpqwoch.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fwqBnH19K28PMS8GtFXnCA_XSc_-Ook

# ---------------------------
# Supabase 서버 전용 비밀 설정 (절대 VITE_ 접두사 사용 금지!)
# 이 값은 서버(Vercel Functions)에서만 사용됩니다.
# 프론트엔드 코드에 절대 포함하지 마세요.
# ---------------------------
SUPABASE_URL=https://ubgwqpafpavrxdpqwoch.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------
# 관리자 설정
# Supabase Auth에 등록된 관리자 계정의 user_id (UUID)
# 여러 명은 쉼표로 구분: uuid1,uuid2
# ---------------------------
ADMIN_USER_IDS=your_admin_user_uuid_here
